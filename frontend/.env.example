# Vite proxies /api to FastAPI, keeping browser requests on the same origin.
VITE_API_URL=/api
API_PROXY_TARGET=http://127.0.0.1:8000
# Firebase Web app config (Firebase console > Project settings > Your apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Avatar uploads use Firebase Storage path avatars/{uid}/avatar.jpg.
# Enable Storage in the Firebase console and allow authenticated users to
# read/write only their own avatars/{uid}/** objects (max ~2MB images).

# Calendar sync (Sprint 2). Optional: the Calendars page explains what's missing if these are blank.
# Google: OAuth "Web application" client ID (Google Cloud Console → APIs & Services → Credentials),
# with the Google Calendar API enabled and http://localhost:5173 as an authorized JavaScript origin.
VITE_GOOGLE_CLIENT_ID=
# Outlook: Microsoft Entra app registration (single-page app) with redirect URI
# http://localhost:5173/msal-redirect.html and the delegated Calendars.Read permission.
VITE_MICROSOFT_CLIENT_ID=
# "common" allows personal and work/school Microsoft accounts.
VITE_MICROSOFT_TENANT=common
