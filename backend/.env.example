MONGODB_URI=mongodb://127.0.0.1:27017
DATABASE_NAME=auto_scheduler
# Firebase project whose ID tokens the API accepts (same as VITE_FIREBASE_PROJECT_ID).
FIREBASE_PROJECT_ID=replace-with-your-firebase-project-id
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Optional: OpenAI Responses API for assistant chat + /schedule/interpret.
# Never commit a real key. Scheduling placement always uses the local engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Sign-up email codes (6 digits, valid 5 minutes). Gmail: use an App Password, never your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Development only: print sign-up codes to the server log instead of emailing them (leave off when SMTP is set).
EMAIL_CODES_TO_LOG=false
# Self-review: a second model call checks the assistant's free-text replies (language, task fit, accuracy)
# before they are shown. Set to false to skip it and save the extra call.
ASSISTANT_SELF_REVIEW=true
